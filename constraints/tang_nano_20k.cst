// Tang Nano 20K, GW2AR-LV18QN88C8/I7.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S2 / KEY2 push button. The board has a 1K pulldown and the switch
// drives the signal to 3.3V, so reset is active-high.
IO_LOC "reset_btn" 87;
IO_PORT "reset_btn" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Six active-low onboard LEDs.
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Reserved FPGA-to-BL616 UART trace, held idle by the current top level.
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Dedicated BL616 <-> FPGA synchronous link. On v3923, GPIO27/MOSI is
// FPGA pin 76 and GPIO30/MISO is FPGA pin 75.
IO_LOC "spi_csn" 86;
IO_LOC "spi_sclk" 13;
IO_LOC "spi_mosi" 76;
IO_LOC "spi_miso" 75;
IO_PORT "spi_csn"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Onboard microSD socket in native 4-bit mode.
IO_LOC "sd_clk" 83;
IO_LOC "sd_cmd" 82;
IO_LOC "sd_dat0" 84;
IO_LOC "sd_dat1" 85;
IO_LOC "sd_dat2" 80;
IO_LOC "sd_dat3" 81;
IO_PORT "sd_clk"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "sd_cmd"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sd_dat1" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sd_dat2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33 PULL_MODE=UP;
